rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : null;
    }

    function isRoleAny(roles) {
      return isSignedIn() && role() in roles;
    }

    function canReadCatalogs() {
      return isRoleAny(['admin', 'director', 'sgi', 'supervisor', 'inspector', 'capturista', 'auxger', 'auxndt', 'aux_ndt', 'cops', 'visor']);
    }

    function canReadOperativo() {
      // Lectura de datos operativos (para dashboard/inspectlist): inspecciones + resúmenes.
      // 'visor' es solo lectura (supervisor operativo): no crear/modificar/borrar.
      return isRoleAny(['admin', 'director', 'sgi', 'supervisor', 'inspector', 'capturista', 'auxger', 'auxndt', 'aux_ndt', 'cops', 'visor']);
    }

    function canCreateInspecciones() {
      return isRoleAny(['admin', 'director', 'sgi', 'supervisor', 'inspector', 'auxndt', 'aux_ndt', 'cops']);
    }

    function canDeleteInspecciones() {
      return isRoleAny(['admin', 'sgi']);
    }

    function canUpdateInspecciones() {
      // Admin-tier: edición completa (correcciones, reasignación, borrado lógico).
      // Inspector/cops/auxndt: SOLO sus propias inspecciones — la sincronización
      // de campo necesita update para adjuntar evidencias/firmas al doc que crearon.
      return isRoleAny(['admin', 'director', 'sgi', 'supervisor'])
        || (
          isRoleAny(['inspector', 'auxndt', 'aux_ndt', 'cops'])
          && (
            resource.data.usuarioInspeccionEmail == request.auth.token.email
            || resource.data.inspectorAsignado == request.auth.token.email
            // Reclamar inspección sin asignar: solo puede cambiar inspectorAsignado a su propio email.
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inspectorAsignado'])
              && request.resource.data.inspectorAsignado == request.auth.token.email
            )
          )
        );
    }

    function canWritePruebas() {
      // Permitir carga/importación de pruebas (PND/calibraciones) desde pruebaslist/pruebas.
      return isRoleAny(['admin', 'director', 'sgi', 'auxger', 'auxndt', 'aux_ndt']);
    }

    function canUpdatePruebas() {
      // Permitir actualización cuando se re-importa CSV y una fila ya existe.
      return isRoleAny(['admin', 'director', 'supervisor', 'sgi', 'auxger', 'auxndt', 'aux_ndt']);
    }

    function canDeletePruebas() {
      // Evitar borrados masivos accidentales.
      return isRoleAny(['admin', 'sgi']);
    }

    function isEquipoOperativoParaInspeccion() {
      // Regla: no permitir guardar inspecciones si el equipo está en WIP/OFF.
      // Excepción: equipo de TERCERO.
      return request.resource.data.equipo is string
        && (
          request.resource.data.equipo == 'TERCERO'
          || (
            // Si no hay registro de EDO para el equipo, permitir (legacy).
            // Si existe, bloquear cuando no sea operativo (ej: WIP/OFF).
            !exists(/databases/$(database)/documents/inventarioEstados/$(request.resource.data.equipo))
            || (
              get(/databases/$(database)/documents/inventarioEstados/$(request.resource.data.equipo)).data.edo in ['ON', 'ACTIVO']
            )
          )
        );
    }

    // Catálogos y formatos (solo lectura para usuarios autenticados)
    match /formatos_inspeccion/{docId} {
      allow read: if canReadCatalogs();
      allow write: if false;
    }

    match /catalogo_danos/{docId} {
      allow read: if canReadCatalogs();
      allow write: if isRoleAny(['admin']);
    }

    match /equipos_overrides/{docId} {
      allow read: if canReadCatalogs();
      allow write: if isRoleAny(['admin']);
    }

    match /equipos/{docId} {
      allow read: if canReadCatalogs();
      allow write: if false;
    }

    match /inventarioEstados/{docId} {
      allow read: if canReadCatalogs();
      allow write: if isRoleAny(['admin', 'director']);
    }

    match /inspecciones/{docId} {
      allow create: if canCreateInspecciones() && isEquipoOperativoParaInspeccion();
      allow read: if canReadOperativo();
      // Update: solo admin-tier, o el inspector dueño/asignado (sync de evidencias).
      allow update: if canUpdateInspecciones();
      allow delete: if canDeleteInspecciones();
    }

    match /resumenes_equipos/{docId} {
      allow read: if canReadOperativo();
      allow write: if false;
    }

    match /resumenes/{docId} {
      allow read: if canReadOperativo();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if canReadCatalogs();
      allow write: if isRoleAny(['admin', 'sgi']);
    }

    match /actividades/{docId} {
      allow read: if canReadOperativo();
      allow write: if false;
    }

    // Órdenes de salida a mantenimiento interno / tercero (despacho desde "No atendidas").
    match /ordenes_salida/{docId} {
      allow read: if canReadOperativo();
      allow create, update: if isRoleAny(['admin', 'director', 'sgi', 'supervisor', 'cops']);
      allow delete: if isRoleAny(['admin']);
    }

    match /pruebas/{docId} {
      allow read: if canReadOperativo();
      allow create: if canWritePruebas();
      allow update: if canUpdatePruebas();
      allow delete: if canDeletePruebas();
    }

    match /audit_logs/{docId} {
      allow read: if isRoleAny(['admin']) || (isSignedIn() && request.auth.token.email == 'the@unknownshoppers.com');
      allow create: if canReadOperativo()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.page is string;
      allow update, delete: if false;
    }

    // Por seguridad, no cambiamos otras colecciones aquí.
  }
}
